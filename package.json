{
  "name": "eos-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Eos: Accessible Vue 3 components and design tokens.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "pnpm --filter @eos-ui/vue dev",
    "test": "pnpm -r test",
    "lint": "eslint . && stylelint \"packages/**/*.{css,vue}\"",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "tokens": "node packages/tokens/scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:package": "pnpm --filter @eos-ui/vue check:package",
    "check:size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
