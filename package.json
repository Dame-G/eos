{
  "name": "eos-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "eos: a component library for Vue, and its design tokens.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "node scripts/dev.mjs",
    "test": "pnpm -r test",
    "lint": "eslint . && stylelint \"packages/**/*.{css,vue}\"",
    "typecheck": "pnpm tokens && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && node scripts/publish.mjs",
    "tokens": "node packages/tokens/scripts/build.mjs",
    "brand": "node brand/build.mjs brand",
    "smoke": "node scripts/smoke.mjs",
    "ssr": "node scripts/ssr.mjs",
    "new:component": "node scripts/new-component.mjs",
    "check:source": "node packages/tokens/scripts/generate.mjs --check && node scripts/check-playwright-image.mjs && pnpm --filter @eos-ui/vue check:source",
    "check:package": "pnpm check:size && pnpm ssr && pnpm --filter @eos-ui/vue check:dist",
    "check:size": "node scripts/size.mjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
