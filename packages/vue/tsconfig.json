{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "@vitest/browser-playwright"]
  },
  "include": ["src/**/*", "src/**/*.vue", "test/**/*", "env.d.ts", "vite.config.ts", "scripts/**/*.ts"]
}
