{
  "name": "@eos-ui/vue",
  "version": "0.18.0",
  "description": "eos: a component library for Vue.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/icons/builtin.js",
    "./src/index.ts",
    "./src/icons/builtin.ts"
  ],
  "files": [
    "dist",
    "THIRD_PARTY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/E*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./fonts.css": "./dist/fonts.css",
    "./fonts-fallback.css": "./dist/fonts-fallback.css",
    "./fonts-self-hosted.css": "./dist/fonts-self-hosted.css",
    "./globals": {
      "types": "./dist/globals.d.ts",
      "default": "./dist/globals.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/builtin": {
      "types": "./dist/icons/builtin.d.ts",
      "default": "./dist/icons/builtin.js"
    },
    "./icons/iconify": {
      "types": "./dist/icons/iconify.d.ts",
      "default": "./dist/icons/iconify.js"
    },
    "./llms-full.txt": "./dist/llms-full.txt",
    "./llms.txt": "./dist/llms.txt",
    "./llms/*": "./dist/llms/*",
    "./package.json": "./package.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "default": "./dist/resolver.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dame-G/eos.git",
    "directory": "packages/vue"
  },
  "scripts": {
    "build": "pnpm prepare:gen && vite build && node scripts/gen-llms.mjs",
    "typecheck": "pnpm prepare:gen && vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm prepare:gen && vitest run",
    "dev": "pnpm prepare:gen && vite build --watch",
    "test:watch": "vitest",
    "prepare:gen": "node scripts/gen-index.mjs",
    "gen:check": "node scripts/gen-index.mjs --check",
    "check:source": "pnpm gen:check && pnpm check:css && pnpm check:props && pnpm check:docs",
    "check:css": "node scripts/check-css.mjs",
    "report:spacing": "node scripts/report-spacing.mjs",
    "gen:props": "node scripts/gen-props.mjs",
    "check:props": "node scripts/gen-props.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:icon-aliases": "node scripts/validate-icon-aliases.mjs",
    "check:dist": "node scripts/check-dist.mjs && node scripts/check-api-types.mjs"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@iconify/vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@eos-ui/tokens": "workspace:*",
    "@tanstack/vue-virtual": "^3.13.48",
    "reka-ui": "^2.11.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "publint": "^0.3.25",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.13"
  },
  "homepage": "https://eos.dame.gg",
  "bugs": {
    "url": "https://github.com/Dame-G/eos/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "components",
    "accessible",
    "a11y",
    "design-tokens",
    "theming"
  ]
}
