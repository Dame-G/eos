{
  "name": "@eos-ui/tokens",
  "version": "0.16.0",
  "description": "eos design tokens: CSS custom properties, typed values and a theme generator with contrast checks.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.auto.css": "./dist/tokens.auto.css",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./tokens.json": "./src/tokens.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dame-G/eos.git",
    "directory": "packages/tokens"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "homepage": "https://eos.dame.gg",
  "bugs": {
    "url": "https://github.com/Dame-G/eos/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "components",
    "accessible",
    "a11y",
    "design-tokens",
    "theming"
  ]
}
